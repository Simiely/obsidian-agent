# ===== Obsidian Agent 配置模板 =====
# 复制为 .env 后按需修改（Docker 部署时由 docker-compose 读取）

# ---- 核心 ----
VAULT_PATH=/vault              # 宿主机 Obsidian 库（compose 中映射到 ./vaults）
PORT=8080
DATA_DIR=/data                 # 索引库 + 备份（compose 中映射到 ./data）
INDEX_BACKEND=fts5             # fts5（默认，零依赖）| meili（需 meilisearch 容器）
# MEILI_URL=http://meilisearch:7700
# MEILI_MASTER_KEY=

# ---- LLM（Agent 必配；不启用 Agent 可留空）----
LLM_PROVIDER=deepseek          # deepseek | openai | kimiapi | ollama | custom
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=                  # 留空按 provider 默认
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# OLLAMA_HOST=http://host.docker.internal:11434

# ---- Vault 行为 ----
IGNORE_DIRS=.obsidian,.trash,.git,node_modules,.stfolder
IGNORE_FILES=
MAX_FILE_BYTES=5242880         # 5MB
WATCH_ENABLED=true
WATCH_DEBOUNCE_SECONDS=2

# ---- 安全 ----
AUTH_TOKEN=                    # 非空时启用简单口令认证（请求头 X-Auth-Token）
DISALLOWED_WRITE_DIRS=.obsidian,.trash,.git

# ---- 备份 ----
BACKUP_ENABLED=true
# 备份根目录：必须位于 vault 之外。Docker 部署务必指向挂载盘（如 /data/backups），
# 否则默认落在容器内 {项目根}/backups，重建容器即丢失
BACKUP_DIR=/data/backups
BACKUP_SCHEDULE=0 2 * * *      # 定时整库快照 cron（已废弃，改为前端活跃式自动备份；空 = 仅手动）
BACKUP_RETENTION=7d,4w,3m      # 保留策略：每日7份 / 每周4份 / 每月3份
BACKUP_MAX_BYTES=10485760      # 快照跳过 10MB 以上文件
BACKUP_VERIFY=true
AUTO_BACKUP_ENABLED=true       # 活跃式自动备份开关
AUTO_BACKUP_INTERVAL_MINUTES=30  # 活跃式自动备份间隔（1~1440）

# ---- 索引性能 ----
INDEX_BATCH_SIZE=200
INDEX_WORKERS=2
JIEBA_USERDICT=             # jieba 自定义词典（如 ./data/userdict.txt，每行一个词）
